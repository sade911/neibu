<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UuVpn" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.UuVpn.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="postSplashScreenTheme">@style/Theme.UuVpn</item>
    </style>
</resources>
